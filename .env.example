# ═══════════════════════════════════════════════════════════════
# EasyGym — variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# ═══════════════════════════════════════════════════════════════

# Driver de datos:
#   mock     → todo vive en localStorage. No necesita Firebase. Ideal para demo.
#   firebase → Firestore + Firebase Authentication reales.
VITE_DATA_DRIVER=mock

# Latencia simulada del driver mock, en ms (para ver los estados de carga).
VITE_MOCK_LATENCY=45

# ── Firebase (cliente) ─────────────────────────────────────────
# Estos valores NO son secretos: identifican tu proyecto y viajan al navegador
# por diseño. Lo que protege tus datos son las reglas de firestore.rules y las
# restricciones de la API key en Google Cloud Console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Stripe (cliente) ───────────────────────────────────────────
# SOLO la clave publicable puede vivir en el frontend.
VITE_STRIPE_PUBLISHABLE_KEY=

# URL base de las Cloud Functions (checkout, webhooks, provisión).
# Vacío en modo demo: se usan los servicios mock.
VITE_FUNCTIONS_URL=

# ═══════════════════════════════════════════════════════════════
# ⛔ LO SIGUIENTE NUNCA VA EN EL FRONTEND NI LLEVA PREFIJO VITE_
#    Va en Cloud Functions:  firebase functions:secrets:set NOMBRE
# ═══════════════════════════════════════════════════════════════
#
# ── Stripe A · SaaS: el DUEÑO le paga a EasyGym ──
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_BUSINESS=price_...
#
# ── Stripe B · Connect: el SOCIO le paga a SU gimnasio ──
# STRIPE_CONNECT_CLIENT_ID=ca_...
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
#
# ── Mensajería ──
# SENDGRID_API_KEY=...
# WHATSAPP_API_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
